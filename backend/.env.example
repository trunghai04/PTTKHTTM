# Database (optional; default: postgresql or sqlite)
# DATABASE_URL=postgresql://user:pass@localhost:5432/text_classification

# JWT (optional; change in production)
# JWT_SECRET=your-secret-key
# JWT_EXPIRES_MINUTES=1440

# Google OAuth + Gmail (optional; enable "Đăng nhập với Google" and Gmail scan)
# Get credentials: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:3000
